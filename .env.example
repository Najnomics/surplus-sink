# Copy to .env and fill in. Never commit .env (it is gitignored).

# Funded deployer key for the target network (0x-prefixed). Needs gas + it will
# hold the seeded demo tokens / LP position.
PRIVATE_KEY=0x...

# RPC endpoints (used by foundry.toml [rpc_endpoints]).
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
UNICHAIN_RPC_URL=https://mainnet.unichain.org

# Optional: Uniscan/Etherscan v2 API key for contract verification.
ETHERSCAN_API_KEY=

# Optional Unichain TEE feeds (leave empty to use owner-gated local builders).
FLASHBLOCK_NUMBER=
BLOCK_BUILDER_POLICY=
PROTECT_RELAYER=
